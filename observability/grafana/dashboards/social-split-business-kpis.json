    },
    {
      "type": "stat",
      "title": "KPI 3 — Tiempo promedio de cierre",
      "description": "Tiempo promedio desde la creación de una operación Social Split hasta su cierre exitoso.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(bankpulse_social_split_sessions_close_duration_seconds_sum) / clamp_min(sum(bankpulse_social_split_sessions_close_duration_seconds_count), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
