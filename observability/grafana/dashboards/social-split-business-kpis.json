  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "KPI 1 — Cierre exitoso de consumos compartidos",
      "description": "Porcentaje de operaciones Social Split iniciadas que terminan correctamente completadas.",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * sum(bankpulse_social_split_sessions_completed_total) / clamp_min(sum(bankpulse_social_split_sessions_initiated_total), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "KPI 2 — Adhesión de participantes",
      "description": "Porcentaje de participantes incorporados que autorizan su participación en el consumo compartido.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * sum(bankpulse_social_split_participants_authorized_total) / clamp_min(sum(bankpulse_social_split_participants_added_total), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
