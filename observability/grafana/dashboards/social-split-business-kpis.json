          "expr": "100 * sum(bankpulse_social_split_settlements_valid_total) / clamp_min(sum(bankpulse_social_split_settlements_valid_total) + sum(bankpulse_social_split_settlements_invalid_total), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
