        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "KPI 4 — Cierres bloqueados por autorización incompleta",
      "description": "Porcentaje de intentos de cierre bloqueados porque todavía faltaban autorizaciones de participantes.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * sum(bankpulse_social_split_sessions_close_blocked_total) / clamp_min(sum(bankpulse_social_split_sessions_close_attempts_total), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
